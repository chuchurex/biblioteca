---
import Layout from '../../layouts/Layout.astro';
import { buildPerson, buildBreadcrumb } from '../../lib/schema';

const persona = buildPerson({
  jobTitle: 'Desarrollador front end',
  sameAs: [
    'https://github.com/chuchurex',
    'https://www.instagram.com/chuchurex/',
  ],
});

// Sitios construidos por Carlos, agrupados por el eje que trabajan.
// Los que no tienen url todavía no están lanzados.
const sitios = [
  {
    eje: 'Espíritu',
    items: [
      {
        nombre: 'Gabriel Lugo',
        dominio: 'gabriel-lugo.com',
        url: 'https://gabriel-lugo.com',
        descripcion:
          'Guía espiritual. El Camino Directo: integrar el verdadero yo a través de la meditación sin esfuerzo.',
      },
      {
        nombre: 'Ser y Fluir',
        dominio: 'seryfluir.cl',
        url: 'https://seryfluir.cl',
        descripcion:
          'Terapias espirituales: el libre albedrío, la muerte y sus procesos, el acompañamiento del alma.',
      },
    ],
  },
  {
    eje: 'Antroposofía',
    items: [
      {
        nombre: 'Pablo Moche',
        dominio: 'pablomoche.cl',
        url: 'https://pablomoche.cl',
        descripcion:
          'Médico de orientación antroposófica. Artículos que conectan la antroposofía con la ciencia moderna.',
      },
      {
        nombre: 'Escuela Escencia',
        dominio: 'escuelaescencia.org',
        url: null,
        descripcion:
          'Escuela de orientación antroposófica. Sitio en construcción.',
      },
    ],
  },
  {
    eje: 'Psique',
    items: [
      {
        nombre: 'Karen Klein',
        dominio: 'karenklein.cl',
        url: 'https://karenklein.cl',
        descripcion:
          'Psicóloga clínica. Terapia individual y familiar sistémica, constelaciones familiares.',
      },
      {
        nombre: 'Eduardo Yentzen',
        dominio: 'yentzen.org',
        url: 'https://yentzen.org',
        descripcion:
          'Escritor y terapeuta. Publicaciones y proyectos sobre desarrollo personal y transformación cultural.',
      },
    ],
  },
  {
    eje: 'Cuerpo',
    items: [
      {
        nombre: 'Sportpits',
        dominio: 'sportpits.cl',
        url: 'https://sportpits.cl',
        descripcion:
          'Quiropraxia profesional en Barrio Italia, Santiago.',
      },
      {
        nombre: 'SaludMasaje',
        dominio: 'saludmasaje.cl',
        url: 'https://saludmasaje.cl',
        descripcion:
          'Masajes corporativos y a domicilio en Santiago, con más de 10 años de experiencia.',
      },
    ],
  },
];
const breadcrumb = buildBreadcrumb([
  { name: 'Inicio', path: '/' },
  { name: 'Acerca', path: '/about/' },
]);
---

<Layout
  title="Acerca — chuchurex"
  description="Quién está detrás de esta biblioteca y cómo conversar directamente conmigo."
  jsonLd={[breadcrumb, persona]}
>
  <section class="py-12 relative overflow-hidden">
    <div class="absolute top-1/2 right-0 -translate-y-1/2 w-64 h-64 border border-white/[0.03] rounded-full translate-x-1/2"></div>
    <div class="container mx-auto px-6 md:px-12 relative z-10">
      <nav class="text-sm text-brand-200 mb-5">
        <a href="/" class="hover:text-accent transition-colors duration-300">Inicio</a>
        <span class="mx-2 text-brand-200/30">/</span>
        <span class="text-brand-50">Acerca</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-display font-bold text-brand-50">Acerca</h1>
    </div>
  </section>

  <section class="py-6">
    <div class="container mx-auto px-6 md:px-12 max-w-4xl">
      <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-start">
        <div class="w-44 md:w-52 flex-shrink-0 mx-auto md:mx-0">
          <img
            src="/images/about/carlos.webp"
            alt="Carlos, curador de esta biblioteca"
            width="368"
            height="400"
            class="w-full"
          />
        </div>
        <div class="flex-1 space-y-4 text-brand-100 leading-relaxed">
          <p class="text-lg text-brand-50">
            Hola, mi nombre es Carlos Martínez. Esta biblioteca es un directorio
            de contenidos audiovisuales de YouTube: audiolibros, conferencias y
            meditaciones, ordenados para que se puedan recorrer.
          </p>

          <p class="text-brand-50 pt-2">Escribir acá:</p>

          <div class="bg-brand-500 rounded-xl border border-white/[0.06] overflow-hidden">
            <div id="chat-messages" class="h-28 overflow-y-auto p-4 space-y-3" aria-live="polite"></div>
            <form id="chat-form" class="flex gap-2 p-3 border-t border-white/[0.06]">
              <input
                id="chat-input"
                type="text"
                maxlength="2000"
                placeholder="Escribe tu mensaje..."
                autocomplete="off"
                class="flex-1 bg-white/[0.06] text-brand-50 placeholder:text-brand-200/60 text-sm rounded-lg px-4 py-2.5 border border-white/[0.06] focus:border-accent/40 focus:outline-none"
              />
              <button
                type="submit"
                class="bg-accent text-brand-700 text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-[#F0BC5A] transition-colors duration-300 disabled:opacity-50"
              >
                Enviar
              </button>
            </form>
          </div>
          <p id="chat-status" class="text-sm text-brand-100 h-5"></p>

          <p class="text-brand-50">Mi correo: chuchurex en gmail.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto px-6 md:px-12 max-w-4xl">
      <h2 class="text-3xl font-display font-bold text-brand-50 mb-3">Sitios que he construido</h2>
      <p class="text-brand-100 leading-relaxed mb-10 max-w-2xl">
        Esta biblioteca no está sola. He construido sitios para personas y
        proyectos que recorren el mismo camino desde distintos ángulos: el
        espíritu, la antroposofía, la psique y el cuerpo.
      </p>

      <div class="space-y-10">
        {sitios.map((grupo) => (
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-accent mb-4">{grupo.eje}</p>
            <div class="grid md:grid-cols-2 gap-4">
              {grupo.items.map((sitio) =>
                sitio.url ? (
                  <a
                    href={sitio.url}
                    target="_blank"
                    rel="noopener"
                    class="block bg-brand-500 rounded-xl border border-white/[0.06] p-5 transition-all duration-300 hover:border-accent/20 hover:-translate-y-1 hover:shadow-card-hover"
                  >
                    <div class="flex items-baseline justify-between gap-3 mb-2">
                      <span class="text-xl font-display font-bold text-brand-50">{sitio.nombre}</span>
                      <span class="text-xs text-brand-200">{sitio.dominio}</span>
                    </div>
                    <p class="text-sm text-brand-100 leading-relaxed">{sitio.descripcion}</p>
                  </a>
                ) : (
                  <div class="bg-brand-500/50 rounded-xl border border-white/[0.04] p-5">
                    <div class="flex items-baseline justify-between gap-3 mb-2">
                      <span class="text-xl font-display font-bold text-brand-100">{sitio.nombre}</span>
                      <span class="text-xs text-brand-200">{sitio.dominio}</span>
                    </div>
                    <p class="text-sm text-brand-200 leading-relaxed">{sitio.descripcion}</p>
                  </div>
                )
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const API = ['localhost', '127.0.0.1'].includes(location.hostname)
    ? 'http://127.0.0.1:8002'
    : 'https://api.chuchurex.cl';

  const messagesEl = document.getElementById('chat-messages')!;
  const formEl = document.getElementById('chat-form') as HTMLFormElement;
  const inputEl = document.getElementById('chat-input') as HTMLInputElement;
  const statusEl = document.getElementById('chat-status')!;

  function getSession(): string {
    let sid = localStorage.getItem('bridge_session');
    if (!sid || !/^[a-f0-9]{32}$/.test(sid)) {
      const bytes = new Uint8Array(16);
      crypto.getRandomValues(bytes);
      sid = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
      localStorage.setItem('bridge_session', sid);
    }
    return sid;
  }

  const session = getSession();
  let lastId = 0;

  function render(from: string, text: string) {
    const wrap = document.createElement('div');
    wrap.className = from === 'visitor' ? 'flex justify-end' : 'flex justify-start';
    const bubble = document.createElement('div');
    bubble.className = from === 'visitor'
      ? 'max-w-[80%] bg-accent/15 text-brand-50 text-sm rounded-lg rounded-br-sm px-3.5 py-2 leading-relaxed'
      : 'max-w-[80%] bg-white/[0.07] text-brand-50 text-sm rounded-lg rounded-bl-sm px-3.5 py-2 leading-relaxed';
    bubble.textContent = text;
    wrap.appendChild(bubble);
    messagesEl.appendChild(wrap);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  async function poll() {
    try {
      const res = await fetch(`${API}/bridge/messages?session_id=${session}&after=${lastId}`);
      if (!res.ok) return;
      const data = await res.json();
      for (const m of data.messages) {
        if (m.id <= lastId) continue;
        render(m.from, m.text);
        lastId = m.id;
      }
    } catch { /* sin red: el proximo poll reintenta */ }
  }

  formEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = inputEl.value.trim();
    if (!text) return;
    inputEl.value = '';
    render('visitor', text);
    statusEl.textContent = '';
    try {
      const res = await fetch(`${API}/bridge/message`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ session_id: session, text }),
      });
      if (res.status === 429) {
        statusEl.textContent = 'Muchos mensajes seguidos. Espera un momento y vuelve a intentar.';
        return;
      }
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      if (data.id > lastId) lastId = data.id;
      statusEl.textContent = data.delivered ? 'Entregado.' : 'Guardado, pero no pude entregarlo. Vuelve a intentar.';
    } catch {
      statusEl.textContent = 'No se pudo enviar. Revisa tu conexión e intenta de nuevo.';
    }
  });

  // Historial previo de la sesion + poll periodico mientras la pestana este visible
  poll();
  setInterval(() => {
    if (document.visibilityState === 'visible') poll();
  }, 4000);
</script>
